# Copy to .env (same folder as package.json) and fill in. .env is git-ignored.

# --- NVR (Hikvision) ---------------------------------------------------------
NVR_URL=http://192.168.1.88
# Use a dedicated NVR user with read-only / event permissions, not admin.
NVR_USERNAME=
NVR_PASSWORD=

# --- My Parking Channel ----------------------------------------------------
MPC_BASE_URL=https://myparkingchannel.app
MPC_TENANT_ID=
# Admin -> Settings -> ANPR relay token (sent as x-relay-token).
MPC_RELAY_TOKEN=
# Optional but recommended: the gate device created for this gateway in admin.
# Keeps it "connected" on the admin ANPR page and tags every gate event.
MPC_DEVICE_ID=

# --- Direction ---------------------------------------------------------------
# NVR channel id -> in/out. On the Fly Parks NVR, D1 = 1 and D2 = 2.
# Reads from channels not listed here are skipped. Catch-up after downtime searches these
# channels and relies on this map (stored reads have no travel direction).
CHANNEL_DIRECTIONS=1:in,2:out
# Optional: use the camera's own travel direction instead, when it reports one.
# CAMERA_DIRECTIONS=forward:in,reverse:out

# --- Tuning --------------------------------------------------------------------
# Same plate on the same channel within this many seconds counts once.
DEDUPE_SECONDS=60
HEARTBEAT_SECONDS=300
# Queue database and logs.
DATA_DIR=data
